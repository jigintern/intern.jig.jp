---
import NorthEast from "../assets/icon/north_east.svg";
interface Props {
  type?: "default" | "first-view";
  wide?: boolean;
}

const { type = "default", wide = false } = Astro.props;
const entryUrl = "https://forms.gle/wdF57WygXuitEvxs8";
const className = [
  type === "first-view" ? "type-first-view" : "",
  wide ? "wide" : "",
]
  .filter(Boolean)
  .join(" ");
---

<a
  class={className || undefined}
  href={entryUrl}
  target="_blank"
  rel="noreferrer"
>
  エントリーする
  <NorthEast class="icon" aria-hidden="true" />
</a>

<style lang="scss">
  a {
    display: flex;
    gap: 8px;
    align-items: center;
    justify-content: center;
    min-width: 216px;
    height: 48px;
    padding-left: 8px;
    font-size: 18px;
    font-weight: 500;
    line-height: 1.3;
    color: var(--entry-button-text);
    text-decoration: none;
    background: var(--entry-button-bg);
    border: 1px solid transparent;
    border-radius: 6px;
    transition: all 0.2s ease;

    .icon {
      width: 24px;
      height: 24px;
      fill: var(--entry-button-icon);
      transition: all 0.2s ease;
    }

    &:hover {
      color: var(--entry-button-text-hover);
      background: var(--entry-button-bg-hover);
      border: var(--entry-button-border-hover);

      .icon {
        fill: var(--entry-button-text-hover);
        transform: translate(4px, -4px);
      }
    }

    &.wide {
      width: 312px;
      height: 64px;
    }
  }

  @media (width <= 720px) {
    a {
      min-width: 160px;
      height: 40px;
      padding-left: 4px;
      font-size: 12px;

      .icon {
        width: 20px;
        height: 20px;
      }
    }
  }
</style>
