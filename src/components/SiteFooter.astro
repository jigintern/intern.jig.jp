---
import JigJpLogo from "../assets/icon/jigjp-logo.svg";
---

<footer>
  <div class="inner">
    <div>
      <JigJpLogo class="logo" />
      <span>インターンシップ</span>
    </div>
    <div class="copylight">© 2026 jig.jp</div>
  </div>
</footer>

<style lang="scss">
  footer {
    background: var(--color-bg-secondary);

    .inner {
      display: flex;
      align-items: center;
      justify-content: space-between;
      max-width: 1240px;
      padding: 24px 20px;
      margin: 0 auto;

      > div {
        display: inline-flex;
        gap: 8px;
        align-items: center;
        color: var(--color-text-primary);

        .logo {
          height: 32px;
          fill: var(--color-text-primary);
        }

        span {
          font-size: 14px;
          font-weight: 500;
          color: var(--color-text-primary);
        }
      }

      .copylight {
        font-size: 14px;
        font-weight: 400;
        line-height: 1.5;
        color: var(--color-text-secondary);
      }
    }
  }

  @media (width <= 720px) {
    footer {
      .inner {
        padding: 20px;

        > div {
          .logo {
            height: 28px;
          }

          span {
            font-size: 12px;
          }
        }

        .copylight {
          font-size: 12px;
        }
      }
    }
  }
</style>
