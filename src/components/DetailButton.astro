---
import ArrowForwardIcon from "../assets/icon/arrow_forward.svg";

interface Props {
  href: string;
}

const { href } = Astro.props;
---

<a href={href}>
  詳細はこちら
  <ArrowForwardIcon class="icon" aria-hidden="true" />
</a>

<style lang="scss">
  a {
    display: inline-flex;
    gap: 8px;
    align-items: center;
    justify-content: center;
    min-width: 184px;
    height: 40px;
    padding: 10px 34px 10px 42px;
    font-size: 14px;
    line-height: 1.3;
    color: var(--color-action-secondary);
    text-decoration: none;
    background: var(--color-bg-primary);
    border: 1px solid var(--color-action-secondary);
    border-radius: 6px;
    transition:
      background-color 0.2s ease,
      color 0.2s ease;

    .icon {
      width: 16px;
      height: 16px;
      fill: var(--color-action-secondary);
      transition:
        transform 0.2s ease,
        fill 0.2s ease;
    }

    &:hover {
      color: var(--color-text-inverse);
      background: var(--color-action-secondary);

      .icon {
        fill: var(--color-text-inverse);
        transform: translateX(8px);
      }
    }
  }

  @media (width <= 720px) {
    a {
      min-width: 160px;
      height: 36px;
      padding: 8px 28px 8px 34px;
      font-size: 13px;
    }
  }
</style>
