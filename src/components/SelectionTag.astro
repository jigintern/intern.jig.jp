---
interface Props {
  hasSelection: boolean;
}

const { hasSelection } = Astro.props;
const label = hasSelection ? "選考アリ" : "選考ナシ！";
---

<span class:list={{ "has-selection": hasSelection }}>
  {label}
</span>

<style lang="scss">
  span {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 74px;
    padding: 2px 16px;
    font-size: 14px;
    line-height: 1.5;
    color: var(--color-text-inverse);
    cursor: default;
    background: var(--color-bg-brand);
    border-radius: 2px;

    &.has-selection {
      color: var(--color-text-brand);
      background: var(--color-bg-primary);
      border: 1px solid var(--color-action-quaternary);
    }
  }
</style>
