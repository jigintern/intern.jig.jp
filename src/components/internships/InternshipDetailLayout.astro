---
import { Picture } from "astro:assets";
import { type CollectionEntry } from "astro:content";
import BreadcrumbArrowIcon from "../../assets/icon/breadcrumb_arrow.svg";
import BaseLayout from "../../layouts/BaseLayout.astro";
import ContactInfoSection from "../ContactInfoSection.astro";
import EntryButton from "../EntryButton.astro";
import PastInternshipArchive from "../PastInternshipArchive.astro";
import SiteFooter from "../SiteFooter.astro";
import SiteHeader from "../SiteHeader.astro";
import StatusTag from "../StatusTag.astro";
import InternshipCard from "../top/InternshipCard.astro";

interface Props {
  internship: CollectionEntry<"internships">;
  stillOpen: CollectionEntry<"internships">[];
}

const { internship, stillOpen } = Astro.props;

const isClosed = internship.data.status === "closed";

const ogImageUrl = new URL(internship.data.image.src, Astro.url).href;
---

<BaseLayout
  title={`${internship.data.title} | jigインターン`}
  description={internship.data.summary}
  ogImageAbsoluteUrl={ogImageUrl}
>
  <div class="page-shell">
    <SiteHeader type="default" />

    <main class="detail-main container-narrow">
      <Picture
        src={internship.data.image}
        alt={internship.data.title}
        width={800}
        formats={["avif", "webp"]}
        pictureAttributes={{ class: "detail-hero" }}
      />

      <section class="detail-summary" id="entry">
        <StatusTag status={internship.data.status} />
        <h1>{internship.data.title}</h1>
        <hr />
        <p class="summary-copy">{internship.data.summary}</p>
        <div class="recommend-box">
          <h4>こんな方におすすめ！</h4>
          <slot name="recommendation" />
        </div>
        {
          isClosed && (
            <div class="closed-overlay" role="note" aria-live="polite">
              このイベントは終了しました。
              <br />
              たくさんのご応募ありがとうございました。
            </div>
          )
        }
      </section>

      <section class="requirements">
        <h3>募集要項</h3>
        <slot name="requirements" />
        {
          !isClosed && (
            <div class="entry-button-wrapper">
              <EntryButton wide />
            </div>
          )
        }
      </section>

      <section class="past-section">
        <h3>過去のインターンシップ（2012年〜）</h3>
        <p>過去参加者ブログから、実際の雰囲気をチェックできます。</p>
        <PastInternshipArchive compact />
      </section>

      {
        stillOpen.length > 0 && (
          <section class="still-open-section">
            <h3>現在募集中のインターンシップ一覧</h3>
            <ul class="still-open-list">
              {stillOpen.map((item) => (
                <li>
                  <InternshipCard internship={item} />
                </li>
              ))}
            </ul>
          </section>
        )
      }

      <ContactInfoSection />
    </main>
    <nav class="breadcrumb" aria-label="パンくず">
      <a href="/">トップページ</a>
      <BreadcrumbArrowIcon aria-hidden="true" class="icon" />
      <p>{internship.data.title}</p>
    </nav>
    <SiteFooter />
  </div>
</BaseLayout>

<style lang="scss">
  .page-shell {
    padding-top: var(--header-height);
  }

  .container-narrow {
    display: flex;
    flex-direction: column;
    gap: 40px;
    max-width: 1040px;
    padding: 64px 20px 96px;
    margin: 0 auto;

    @media (width <= 720px) {
      gap: 32px;
      padding: 32px 16px 64px;
    }
  }

  .detail-main {
    min-height: calc(100vh - 80px);
  }

  .detail-hero {
    display: block;
    width: 800px;
    max-width: calc(100% - 80px);
    margin: 0 auto;

    :global(img) {
      display: block;
      width: 100%;
      height: auto;
      object-fit: contain;
    }

    @media (width <= 720px) {
      width: 100%;
      max-width: 100%;
    }
  }

  .detail-summary,
  .requirements,
  .past-section,
  .still-open-section,
  :global(.detail-free-content) {
    padding: 40px;
    background: var(--color-bg-primary);
    border-radius: 8px;
  }

  @media (width <= 720px) {
    .detail-summary,
    .requirements,
    .past-section,
    .still-open-section,
    :global(.detail-free-content) {
      padding: 24px 20px;
    }
  }

  #entry {
    position: relative;
    overflow: hidden;
    border: solid 2px var(--color-bg-brand);
  }

  .closed-overlay {
    position: absolute;
    inset: -2px;
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: 0;
    align-items: center;
    justify-content: center;
    padding: 24px;
    font-size: 20px;
    font-weight: 500;
    line-height: 1.5;
    color: var(--color-text-inverse);
    text-align: center;
    background: rgb(48 42 42 / 60%);
    border-radius: 8px;
  }

  .detail-summary h1 {
    margin-top: 4px;
    font-size: 40px;
    line-height: 1.5;
    color: var(--color-text-brand);
  }

  .detail-summary p {
    font-size: 16px;
    line-height: 1.6;
  }

  .detail-summary .summary-copy {
    white-space: pre-line;
  }

  .detail-summary hr {
    width: 100%;
    height: 1px;
    margin: 16px 0;
    background: var(--color-action-tertiary);
    border: 0;

    @media (width <= 720px) {
      margin: 12px 0;
    }
  }

  .recommend-box {
    padding: 16px 24px;
    margin-top: 24px;
    background: var(--color-bg-tag);
    border-radius: 6px;

    @media (width <= 720px) {
      padding: 12px 16px;
      margin-top: 16px;
    }
  }

  .recommend-box h4 {
    margin-bottom: 8px;
    font-size: 20px;
    font-weight: 500;
    line-height: 1.5;
    color: var(--color-text-brand);
  }

  :global(.recommend-copy) {
    margin: 0;
    font-size: 16px;
    font-weight: 400;
    line-height: 1.6;
    white-space: pre-line;
  }

  .requirements h3,
  .past-section h3,
  .still-open-section h3,
  :global(.detail-free-content h3) {
    padding-left: 16px;
    margin-bottom: 24px;
    font-size: 28px;
    font-weight: 700;
    line-height: 1.5;
    color: var(--color-text-brand);
    border-left: 8px solid var(--color-text-brand);
  }

  :global(.detail-free-content p) {
    margin: 0;
    font-size: 16px;
    line-height: 1.6;
  }

  :global(.detail-free-content p + p) {
    margin-top: 12px;
  }

  .past-section > p {
    margin-bottom: 32px;
    font-size: 20px;
    font-weight: 500;
    line-height: 1.5;
    color: var(--color-text-primary);

    @media (width <= 720px) {
      margin-bottom: 20px;
      font-size: 14px;
    }
  }

  .entry-button-wrapper {
    display: flex;
    justify-content: center;
    margin-top: 32px;

    --entry-button-bg: var(--color-action-primary);
    --entry-button-bg-hover: var(--color-action-primary-hover);
    --entry-button-text: var(--color-text-inverse);
    --entry-button-text-hover: var(--color-text-inverse);
    --entry-button-icon: var(--color-text-inverse);
    --entry-button-border-hover: transparent;

    @media (width <= 720px) {
      margin-top: 20px;
    }
  }

  .breadcrumb {
    display: flex;
    gap: 16px;
    align-items: center;
    max-width: 1040px;
    padding: 0 20px;
    margin: 0 auto 24px;
    font-size: 14px;
    font-weight: 400;
    line-height: 1.5;
    color: var(--color-text-secondary);

    a {
      color: var(--color-text-secondary);
      text-decoration: underline;

      &:hover {
        color: var(--color-text-brand);
      }
    }

    p {
      margin: 0;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    .icon {
      width: 16px;
      height: 16px;
      fill: var(--color-text-secondary);
    }

    @media (width <= 720px) {
      gap: 8px;
      padding: 0 16px;
      margin-bottom: 16px;
      font-size: 12px;

      .icon {
        width: 12px;
        height: 12px;
      }
    }
  }

  .still-open-list {
    padding-left: 0;
    margin: 0;
    list-style: none;

    li + li {
      padding-top: 32px;
      margin-top: 32px;
      border-top: 1px solid var(--color-bg-secondary);
    }
  }

  @media (width <= 720px) {
    .detail-summary h1 {
      margin-top: 2px;
      font-size: 22px;
    }

    .detail-summary p {
      font-size: 14px;
    }

    .closed-overlay {
      font-size: 16px;
    }

    .recommend-box h4 {
      margin-bottom: 6px;
      font-size: 16px;
    }

    :global(.recommend-copy) {
      font-size: 13px;
    }

    .requirements h3,
    .past-section h3,
    .still-open-section h3,
    :global(.detail-free-content h3) {
      padding-left: 12px;
      margin-bottom: 16px;
      font-size: 20px;
      border-left-width: 6px;
    }

    :global(.detail-free-content p) {
      font-size: 13px;
    }
  }
</style>
