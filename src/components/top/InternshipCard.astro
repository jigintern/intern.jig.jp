---
import { Picture } from "astro:assets";
import DetailButton from "../DetailButton.astro";
import StatusTag from "../StatusTag.astro";
import SelectionTag from "../SelectionTag.astro";
import type { CollectionEntry } from "astro:content";

interface Props {
  internship: CollectionEntry<"internships">;
}

const { internship } = Astro.props;
const detailHref = `${import.meta.env.BASE_URL}internships/${internship.id}/`;
---

<article>
  <a href={detailHref}>
    <Picture
      src={internship.data.image}
      alt={internship.data.title}
      formats={["avif", "webp"]}
      width={384}
    />
  </a>
  <div>
    <div class="tags">
      <StatusTag status={internship.data.status} />
      <SelectionTag hasSelection={internship.data.hasSelection} />
    </div>
    <h3>{internship.data.title}</h3>
    <p class="summary">
      {internship.data.shortSummary || internship.data.summary}
    </p>
    <DetailButton href={detailHref} />
  </div>
</article>

<style lang="scss">
  article {
    display: grid;
    grid-template-columns: 384px 1fr;
    gap: 24px;
    align-items: center;

    .summary {
      display: -webkit-box;
      overflow: hidden;
      -webkit-line-clamp: 3;
      white-space: pre-line;
      -webkit-box-orient: vertical;
    }

    .tags {
      display: flex;
      gap: 8px;
    }
  }

  article > a {
    overflow: hidden;
  }

  article > a :global(img) {
    display: block;
    width: 100%;
    height: auto;
    object-fit: cover;
    transition: transform 0.2s ease-out;
  }

  article > a:hover :global(img) {
    transform: scale(1.03);
  }

  article > div > h3 {
    margin-top: 8px;
    font-size: 28px;
    line-height: 1.5;
    color: var(--color-text-brand);
  }

  article > div > p {
    margin: 10px 0 16px;
    font-size: 14px;
  }

  @media (width <= 720px) {
    article {
      grid-template-columns: 1fr;
      gap: 16px;
    }

    article > a :global(img) {
      width: 100%;
      height: auto;
    }

    article > div > h3 {
      margin-top: 4px;
      font-size: 20px;
    }

    article > div > p {
      margin: 6px 0 12px;
      font-size: 13px;
    }
  }
</style>
