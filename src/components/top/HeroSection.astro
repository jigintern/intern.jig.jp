---
import { Picture } from "astro:assets";
import type { CollectionEntry } from "astro:content";

interface Props {
  internships: CollectionEntry<"internships">[];
}

const { internships } = Astro.props;
const openInternships = internships.filter(
  (item) => item.data.status === "open",
);
const heroSlides =
  openInternships.length === 0
    ? []
    : Array.from(
        {
          length:
            Math.ceil(6 / openInternships.length) * openInternships.length,
        },
        (_, i) => openInternships[i % openInternships.length],
      );
const toInternshipHref = (id: string) =>
  `${import.meta.env.BASE_URL}internships/${id}/`;
---

<section class="hero">
  <div class="embla" data-hero-count={openInternships.length}>
    <div class="embla__viewport">
      <div class="embla__container">
        {
          heroSlides.map((item) => (
            <a class="image-link embla__slide" href={toInternshipHref(item.id)}>
              <Picture
                src={item.data.image}
                alt={item.data.title}
                width={800}
                height={420}
                formats={["avif", "webp"]}
              />
            </a>
          ))
        }
      </div>
    </div>
  </div>
  <div class="pager-inline">
    {
      openInternships.map((item, index) => (
        <button
          type="button"
          class={`pager-dot ${index === 0 ? "active" : ""}`}
          data-embla-dot
          aria-label={`${item.data.title}へ移動`}
        />
      ))
    }
  </div>
</section>

<script>
  import EmblaCarousel from "embla-carousel";
  import Autoplay from "embla-carousel-autoplay";

  const initializeHeroSections = () => {
    const heroSection = document.querySelector<HTMLElement>(".hero");
    if (!heroSection) return;

    if (heroSection.dataset.jsInitialized === "true") return;

    const emblaRoot = heroSection.querySelector<HTMLElement>(".embla");
    const emblaViewport =
      emblaRoot?.querySelector<HTMLElement>(".embla__viewport");
    const heroCount = Number(emblaRoot?.getAttribute("data-hero-count") ?? "0");
    const emblaDots = Array.from(
      heroSection.querySelectorAll<HTMLButtonElement>("[data-embla-dot]"),
    );

    if (!emblaRoot || !emblaViewport || heroCount === 0) return;
    heroSection.dataset.jsInitialized = "true";

    const embla = EmblaCarousel(
      emblaViewport,
      {
        align: "center",
        loop: true,
      },
      [
        Autoplay({
          delay: 15000,
          stopOnInteraction: false,
          stopOnMouseEnter: true,
        }),
      ],
    );

    const updateEmblaDots = () => {
      const selectedIndex = embla.selectedScrollSnap() % heroCount;
      emblaDots.forEach((dot, index) => {
        const isActive = index === selectedIndex;
        dot.setAttribute("aria-current", isActive ? "true" : "false");
      });
      embla.plugins().autoplay.reset();
    };

    emblaDots.forEach((dot, index) => {
      dot.addEventListener("click", () => {
        const snapCount = embla.scrollSnapList().length;
        const currentSnap = embla.selectedScrollSnap();
        const candidates: number[] = [];

        for (let snap = index; snap < snapCount; snap += heroCount) {
          candidates.push(snap);
        }

        const targetSnap = candidates.reduce((closest, candidate) => {
          const closestDistance = Math.min(
            Math.abs(closest - currentSnap),
            snapCount - Math.abs(closest - currentSnap),
          );
          const candidateDistance = Math.min(
            Math.abs(candidate - currentSnap),
            snapCount - Math.abs(candidate - currentSnap),
          );
          return candidateDistance < closestDistance ? candidate : closest;
        }, candidates[0] ?? index);

        embla.scrollTo(targetSnap);
      });

      embla.on("select", updateEmblaDots);
      embla.on("reInit", updateEmblaDots);
      updateEmblaDots();
    });
  };

  initializeHeroSections();
  document.addEventListener("astro:page-load", initializeHeroSections);
</script>

<style lang="scss">
  .hero {
    padding-top: var(--header-height);
    background-color: var(--color-bg-brand);
    background-image:
      linear-gradient(
        0deg,
        transparent calc(100% - 1px),
        rgb(255 255 255 / 10%) calc(100% - 1px)
      ),
      linear-gradient(
        90deg,
        transparent calc(100% - 1px),
        rgb(255 255 255 / 10%) calc(100% - 1px)
      );
    background-repeat: repeat;
    background-position: center center;
    background-size: 28px 28px;
  }

  .embla {
    margin-top: 16px;

    @media (width <= 720px) {
      margin-top: 8px;
    }
  }

  .embla__viewport {
    overflow: hidden;
  }

  .embla__container {
    display: flex;
  }

  .embla__slide {
    flex: 0 0 800px;
    min-width: 0;
    margin: 0 16px;

    @media (width <= 720px) {
      margin: 0 8px;
    }
  }

  .image-link {
    display: block;
    overflow: hidden;
    border-radius: 2px;
  }

  .image-link img {
    display: block;
    width: 100%;
    transition: transform 0.25s ease;
  }

  .embla__slide .image-link {
    border: 1px solid rgb(255 255 255 / 40%);
  }

  .embla__slide img {
    width: 100%;
    height: auto;
    aspect-ratio: 1200 / 630;
    object-fit: cover;
  }

  .pager-inline {
    display: flex;
    gap: 8px;
    justify-content: center;
    padding: 24px 24px 32px;

    @media (width <= 720px) {
      padding-top: 8px;
      padding-bottom: 16px;
    }

    .pager-dot {
      position: relative;
      flex: 1;
      max-width: 104px;
      height: 24px;
      padding: 0;
      cursor: pointer;
      background: transparent;
      border: 0;

      &::before {
        position: absolute;
        top: 50%;
        left: 0;
        width: 100%;
        height: 4px;
        content: "";
        background: var(--color-action-primary-hover);
        border-radius: 999px;
        transform: translateY(-50%);
        transition: background 0.25s ease;
      }

      &[aria-current="true"]::before {
        background: var(--color-action-inverse);
      }
    }
  }

  .image-link:hover img {
    transform: scale(1.03);
  }

  @media (width <= 720px) {
    .embla__slide {
      flex-basis: 65%;
    }
  }
</style>
